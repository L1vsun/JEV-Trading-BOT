# Create a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# MetaTrader 5. Leave all three unset to use the terminal you are already
# logged into. Never commit real values; .env is gitignored.
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
# Optional path to terminal64.exe when it is not on the default install path.
# MT5_PATH=
# Real-money and cent accounts also need this exact phrase, together with
# --allow-real, before any order is sent. Leave it unset for dry-run and demo.
# MT5_CONFIRM_REAL=YES_TRADE_REAL
